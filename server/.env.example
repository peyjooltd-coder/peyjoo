NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# SQLite path (create data/ automatically)
DATABASE_PATH=./data/divar.db

# Change in production — min 32 chars
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Comma-separated origins (Vite dev + production URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo login (seeded user)
DEMO_EMAIL=demo@divarvancouver.ca
DEMO_PASSWORD=demo1234
